{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verification-pilot.invalid/schemas/verification-http-log-v1.json",
  "title": "Verification HTTP request log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "request_id", "method", "path", "status_code", "duration_ms"],
  "properties": {
    "schema_version": {"const": "verification-http-log-v1"},
    "event": {"const": "http_request"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]},
    "path": {"type": "string", "pattern": "^/"},
    "status_code": {"type": "integer", "minimum": 100, "maximum": 599},
    "duration_ms": {"type": "number", "minimum": 0}
  }
}
