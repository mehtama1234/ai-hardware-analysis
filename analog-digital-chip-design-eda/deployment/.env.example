# Copy to .env and replace before starting docker compose.
VERIFICATION_SERVICE_API_KEY=replace-with-a-long-random-secret
# Keep pilot for the local reference backend. Customer production requires all
# managed declarations below and a provider implementation that passes readiness.
VERIFICATION_DEPLOYMENT_TIER=pilot
# VERIFICATION_DATABASE_URL=postgresql://user:password@managed-db/verification
# VERIFICATION_EVIDENCE_STORE_PROVIDER=object-store
# VERIFICATION_EVIDENCE_STORE_BUCKET=customer-verification-evidence
# VERIFICATION_REQUIRE_IDENTITY_SUBJECT=true
# VERIFICATION_REVIEWER_ROLE=verification-reviewer
# VERIFICATION_IDENTITY_ISSUER=https://issuer.example.com/
# VERIFICATION_IDENTITY_AUDIENCE=verification-platform
# VERIFICATION_IDENTITY_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# VERIFICATION_REQUIRE_IDENTITY_TOKEN=true
# VERIFICATION_EXECUTION_SANDBOX=isolated
# VERIFICATION_EXECUTION_WORKSPACE=disposable
# VERIFICATION_EXECUTION_NETWORK_POLICY=deny-by-default
# VERIFICATION_JOB_MAX_WORKSPACE_BYTES=2147483648
# VERIFICATION_JOB_MAX_FILE_BYTES=536870912
# VERIFICATION_OBSERVABILITY_ENDPOINT=https://otel.example.internal
# VERIFICATION_BACKUP_POLICY=daily-35d
# VERIFICATION_DR_RPO_MINUTES=15
# VERIFICATION_DR_RTO_MINUTES=60
# VERIFICATION_BACKUP_SCHEDULE=0 * * * *
# Optional JSON map for tenant-scoped project routes, e.g.
# VERIFICATION_PROJECT_KEYS={"customer_a":"project-secret"}
# Optional JSON identity map for tenant-scoped project routes, e.g.
# VERIFICATION_PROJECT_SUBJECTS={"customer_a":["oidc|alice","oidc|bob"]}
# For Docker/Kubernetes secrets, set VERIFICATION_SERVICE_API_KEY_FILE instead.
# VERIFICATION_SERVICE_API_KEY_FILE=/run/secrets/verification_api_key
VERIFICATION_WORKER_TIMEOUT_SECONDS=1800
VERIFICATION_JOB_TIMEOUT_SECONDS=1800
VERIFICATION_MAX_QUEUED_JOBS=32
VERIFICATION_API_CPUS=1.0
VERIFICATION_API_MEMORY=512m
VERIFICATION_WORKER_CPUS=2.0
VERIFICATION_WORKER_MEMORY=2g
# Optional provider-neutral local/open model backends for the execution-loop agent.
# VERIFICATION_LLM_COMMAND=python3 scripts/hf_llm_backend.py
# VERIFICATION_LLM_BATCH_COMMAND=python3 scripts/hf_llm_batch_backend.py
# VERIFICATION_HF_MODEL=/models/smollm2-360m-instruct
# VERIFICATION_HF_MAX_NEW_TOKENS=64
# VERIFICATION_LLM_BASE_URL=http://127.0.0.1:8080
# VERIFICATION_LLM_MODEL=local-model
