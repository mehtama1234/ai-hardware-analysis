.measure tran conv1_decision4_comparator_diff_v FIND par('v(outn)-v(outp)') AT=68.00n
.measure tran conv1_decision4_preamp_diff_v FIND par('v(pre_n)-v(pre_p)') AT=64.80n
.measure tran conv1_decision4_latched_diff_v FIND par('v(outn)-v(outp)') AT=66.40n
.measure tran conv1_decision4_sp_v FIND v(sp) AT=60.00n
.measure tran conv1_decision4_sn_v FIND v(sn) AT=60.00n
.measure tran final_output_diff_v FIND par('v(outn)-v(outp)') AT=79.70n
.control
run
.endc
.end
