XCONT_BP3_0_7 db3 gp_dac3 vdd vdd sky130_fd_pr__pfet_01v8 W=8 L=0.15
VREF inn 0 PWL(0n 0.302156250 80n 0.302156250)
VSRC_DAC srcin 0 0.004000000
VDAC_CTRL dac_ctrl 0 PULSE(0 {vdd} 0.1n 10p 10p 4.0n 80n)
VDAC_CTRLB dac_ctrlb 0 PULSE({vdd} 0 0.1n 10p 10p 4.0n 80n)
XDS_DAC srcin dac_ctrl top 0 sky130_fd_pr__nfet_01v8 W=32.0 L=0.15
XDP_DAC srcin dac_ctrlb top vdd sky130_fd_pr__pfet_01v8 W=64.0 L=0.15
* Matched source followers isolate the floating DAC/reference nodes from the comparator sample capacitors.
* Buffer control variant: direct late sampling is retained as the comparison
* baseline. The source-follower variant is documented in prior evidence.
CDAC0 top db0 8.000000000000e-12
CDACDUMMY0 db0 0 0.01p
CDAC1 top db1 3.000000000000e-12
CDACDUMMY1 db1 0 0.01p
CDAC2 top db2 2.000000000000e-12
CDACDUMMY2 db2 0 0.01p
CDAC3 top db3 1.500000000000e-12
CDACDUMMY3 db3 0 0.01p
CDAC_TOP_DUMMY top 0 0.5p
XBN_DAC0 db0 gn_dac0 0 0 sky130_fd_pr__nfet_01v8 W=64 L=0.15
XBN_DAC1 db1 gn_dac1 0 0 sky130_fd_pr__nfet_01v8 W=64 L=0.15
XBN_DAC2 db2 gn_dac2 0 0 sky130_fd_pr__nfet_01v8 W=64 L=0.15
XBN_DAC3 db3 gn_dac3 0 0 sky130_fd_pr__nfet_01v8 W=64 L=0.15










VCTRL ctrl 0 PULSE(0 {vdd} 9.10n 20p 20p 0.50n 16n)
VCTRLB ctrlb 0 PULSE({vdd} 0 9.10n 20p 20p 0.50n 16n)
VCLK clk 0 PULSE(0 {vdd} 12.70n 20p 20p 5n 16n)
VCLKB clkb 0 PULSE({vdd} 0 11.70n 20p 20p 1n 16n)

XSWNP top ctrl sp vss sky130_fd_pr__nfet_01v8 W={wn} L={lmin}
XSWPP top ctrlb sp vdd sky130_fd_pr__pfet_01v8 W={wp} L={lmin}
XSWNN inn ctrl sn vss sky130_fd_pr__nfet_01v8 W={wn} L={lmin}
XSWPN inn ctrlb sn vdd sky130_fd_pr__pfet_01v8 W={wp} L={lmin}
XDUMNP sp ctrlb sp vss sky130_fd_pr__nfet_01v8 W={dummy_wn} L={lmin}
XDUMPP sp ctrl sp vdd sky130_fd_pr__pfet_01v8 W={dummy_wp} L={lmin}
XDUMNN sn ctrlb sn vss sky130_fd_pr__nfet_01v8 W={dummy_wn} L={lmin}
XDUMPN sn ctrl sn vdd sky130_fd_pr__pfet_01v8 W={dummy_wp} L={lmin}
CSP sp 0 {cstore}
CSN sn 0 {cstore}
RLEAKP sp 0 100G
RLEAKN sn 0 100G

RPREP vdd pre_p {pre_rd}
RPREN vdd pre_n {pre_rd}
XPREP pre_p handoff_p pre_tail_node 0 sky130_fd_pr__nfet_01v8 W={pre_w} L={lmin}
XPREN pre_n handoff_n pre_tail_node 0 sky130_fd_pr__nfet_01v8 W={pre_w} L={lmin}
IPRE pre_tail_node 0 PULSE(0 {pre_tail} 10.70n 20p 20p 5n 16n)
CPREP pre_p 0 2f
CPREN pre_n 0 2f

XLPRE1 vdd clkb outp vdd sky130_fd_pr__pfet_01v8 W={wp_latch} L={lmin}
XLPRE2 vdd clkb outn vdd sky130_fd_pr__pfet_01v8 W={wp_latch} L={lmin}
XLP outp outn vdd vdd sky130_fd_pr__pfet_01v8 W={wp_latch} L={lmin}
XLN outp outn eval 0 sky130_fd_pr__nfet_01v8 W={wn_latch} L={lmin}
XRP outn outp vdd vdd sky130_fd_pr__pfet_01v8 W={wp_latch} L={lmin}
XRN outn outp eval 0 sky130_fd_pr__nfet_01v8 W={wn_latch} L={lmin}
XINP outp pre_p tail 0 sky130_fd_pr__nfet_01v8 W={wn_in} L={lmin}
XINN outn pre_n tail 0 sky130_fd_pr__nfet_01v8 W={wn_in} L={lmin}
XTAIL tail clk 0 0 sky130_fd_pr__nfet_01v8 W={wn_tail} L={lmin}
XEVAL eval clk 0 0 sky130_fd_pr__nfet_01v8 W={wn_tail} L={lmin}
* Optional post-sample switched direct DAC/reference handoff.
VCONT_HANDOFF_CM handoff_cm 0 {vdd/2}
BCONT_HANDOFF handoff_enable 0 V=0+1.8*u(time-9.7n)*(1-u(time-11.7n))+1.8*u(time-25.7n)*(1-u(time-27.7n))+1.8*u(time-41.7n)*(1-u(time-43.7n))+1.8*u(time-57.7n)*(1-u(time-59.7n))
RHANDOFF_P handoff_p handoff_cm 1e+06
RHANDOFF_N handoff_n handoff_cm 1e+06
XHANDOFF_P handoff_p handoff_enable top 0 sky130_fd_pr__nfet_01v8 W=8 L=0.15
XHANDOFF_N handoff_n handoff_enable inn 0 sky130_fd_pr__nfet_01v8 W=8 L=0.15
COUTP outp 0 5f
COUTN outn 0 5f

.ic v(db0)=0 v(db1)=0 v(db2)=0 v(db3)=0 v(sp)=0.9 v(sn)=0.9 v(pre_p)=1.0 v(pre_n)=1.0 v(pre_tail_node)=0.25 v(outp)=1.8 v(outn)=1.8
BRAW1 raw_dec1 0 V=1.8*u(V(outn)-V(outp))
