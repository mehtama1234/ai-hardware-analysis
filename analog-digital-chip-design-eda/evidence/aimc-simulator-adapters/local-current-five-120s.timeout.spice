BCONT_SAMPLE_RESET sample_reset 0 V=0+1.8*u(time-0.5n)*(1-u(time-4n))+1.8*u(time-16.5n)*(1-u(time-20n))+1.8*u(time-32.5n)*(1-u(time-36n))+1.8*u(time-48.5n)*(1-u(time-52n))+1.8*u(time-80.5n)*(1-u(time-84n))+1.8*u(time-96.5n)*(1-u(time-100n))+1.8*u(time-112.5n)*(1-u(time-116n))+1.8*u(time-128.5n)*(1-u(time-132n))+1.8*u(time-160.5n)*(1-u(time-164n))+1.8*u(time-176.5n)*(1-u(time-180n))+1.8*u(time-192.5n)*(1-u(time-196n))+1.8*u(time-208.5n)*(1-u(time-212n))+1.8*u(time-240.5n)*(1-u(time-244n))+1.8*u(time-256.5n)*(1-u(time-260n))+1.8*u(time-272.5n)*(1-u(time-276n))+1.8*u(time-288.5n)*(1-u(time-292n))+1.8*u(time-320.5n)*(1-u(time-324n))+1.8*u(time-336.5n)*(1-u(time-340n))+1.8*u(time-352.5n)*(1-u(time-356n))+1.8*u(time-368.5n)*(1-u(time-372n))
R_SAMPLE_RESET_P sp sample_reset_p 10000
R_SAMPLE_RESET_N sn sample_reset_n 10000
XSAMPLE_RESET_P sample_reset_p sample_reset sample_cm 0 sky130_fd_pr__nfet_01v8 W=3.5 L=0.15
