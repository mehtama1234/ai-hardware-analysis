{
  "schema_version": "analog-simulator-adapter-output-schema-v0.1",
  "result_type": "analog_simulator_adapter_output_contract",
  "required_source_id": "analog_error_simulation",
  "required_top_level_fields": [
    "error_model",
    "temperature_range",
    "voltage_range",
    "accuracy_impact",
    "calibration_profile",
    "provenance"
  ],
  "required_error_model_fields": [
    "name",
    "tool",
    "target_object",
    "adc_bits",
    "dac_bits",
    "final_residual_relative",
    "final_residual_q8",
    "device_assumptions",
    "array_assumptions"
  ],
  "required_accuracy_impact_fields": [
    "estimated_drop",
    "pass",
    "metric",
    "baseline_reference",
    "simulated_reference",
    "boundary"
  ],
  "required_provenance_fields": [
    "tool",
    "tool_version",
    "measurement_level",
    "not_measured_silicon",
    "generated_at",
    "repo",
    "artifacts",
    "claim_boundary"
  ],
  "accepted_tool_name_fragments": [
    "aihwkit",
    "crosssim",
    "spice",
    "ngspice",
    "xyce",
    "aimc-calibrated-simulator"
  ],
  "claim_rule": {
    "allowed": "A real adapter payload may support bounded analog simulator evidence only when the named tool ran and the output identifies the reviewed model layer, array case, assumptions, residual, and accuracy boundary.",
    "not_allowed": "A skipped adapter, missing module check, local proxy without a named simulator run, or undocumented fixture must not be imported as strict simulator evidence."
  }
}
