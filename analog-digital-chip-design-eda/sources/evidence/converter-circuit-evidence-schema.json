{
  "schema_version": "converter-circuit-evidence-v0.1",
  "required_top_level_fields": [
    "result_type",
    "converter_id",
    "measurement_level",
    "target_boundary",
    "energy",
    "latency",
    "noise",
    "area",
    "sharing",
    "provenance",
    "claim_boundary"
  ],
  "allowed_measurement_levels": [
    "local_estimate",
    "circuit_simulation",
    "post_layout_simulation",
    "measured_silicon"
  ],
  "required_target_boundary_fields": [
    "adc_bits",
    "dac_bits",
    "output_noise_budget"
  ],
  "required_energy_fields": [
    "adc_energy_per_conversion",
    "dac_energy_per_row_drive",
    "energy_unit",
    "method"
  ],
  "required_latency_fields": [
    "adc_comparisons",
    "conversion_time_ns",
    "settling_time_ns",
    "method"
  ],
  "required_noise_fields": [
    "output_noise_rms",
    "input_referred_noise",
    "meets_output_noise_budget",
    "method"
  ],
  "required_area_fields": [
    "adc_area_um2",
    "dac_area_um2",
    "replication_or_sharing_rule",
    "method"
  ],
  "required_sharing_fields": [
    "rows_served",
    "columns_served",
    "outputs_per_conversion_cost",
    "converter_instances"
  ],
  "claim_rule": "Only post_layout_simulation or measured_silicon can replace the local break-even assumption. Circuit simulation can narrow the target. Local estimates stay planning evidence only."
}
