#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5903a4f3f490 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5903a4f52480 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x5903a4f66450_0 .var "data", 3 0;
v0x5903a4f66510_0 .net "even", 0 0, L_0x5903a4f66830;  1 drivers
v0x5903a4f665e0_0 .var "rst", 0 0;
S_0x5903a4f52610 .scope module, "dut" "parity" 3 3, 4 1 0, S_0x5903a4f52480;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "rst";
    .port_info 1 /INPUT 4 "data";
    .port_info 2 /OUTPUT 1 "even";
L_0x71de3ce9f018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5903a4f527f0_0 .net/2u *"_ivl_0", 0 0, L_0x71de3ce9f018;  1 drivers
v0x5903a4f66080_0 .net *"_ivl_3", 0 0, L_0x5903a4f66710;  1 drivers
v0x5903a4f66140_0 .net "data", 3 0, v0x5903a4f66450_0;  1 drivers
v0x5903a4f66200_0 .net "even", 0 0, L_0x5903a4f66830;  alias, 1 drivers
v0x5903a4f662c0_0 .net "rst", 0 0, v0x5903a4f665e0_0;  1 drivers
L_0x5903a4f66710 .reduce/xor v0x5903a4f66450_0;
L_0x5903a4f66830 .functor MUXZ 1, L_0x5903a4f66710, L_0x71de3ce9f018, v0x5903a4f665e0_0, C4<>;
    .scope S_0x5903a4f52480;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5903a4f665e0_0, 0, 1;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x5903a4f66450_0, 0, 4;
    %end;
    .thread T_0, $init;
    .scope S_0x5903a4f52480;
T_1 ;
    %vpi_call/w 3 5 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 5 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5903a4f52480 {0 0 0};
    %delay 1, 0;
    %load/vec4 v0x5903a4f66510_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 6 "$display", "FAIL cycle=0 signal=even expected=0 actual=%0d", v0x5903a4f66510_0 {0 0 0};
    %vpi_call/w 3 6 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5903a4f665e0_0, 0, 1;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x5903a4f66450_0, 0, 4;
    %delay 1, 0;
    %load/vec4 v0x5903a4f66510_0;
    %cmpi/ne 1, 0, 1;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 8 "$display", "FAIL cycle=1 signal=even expected=1 actual=%0d", v0x5903a4f66510_0 {0 0 0};
    %vpi_call/w 3 8 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.2 ;
    %vpi_call/w 3 9 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 9 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_1;
