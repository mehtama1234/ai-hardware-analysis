#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5759ea1f3860 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5759ea206fc0 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x5759ea218020_0 .net "ready", 0 0, L_0x5759ea218190;  1 drivers
v0x5759ea2180c0_0 .var "rst", 0 0;
S_0x5759ea207150 .scope module, "dut" "handshake" 3 3, 4 1 0, S_0x5759ea206fc0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "rst";
    .port_info 1 /OUTPUT 1 "ready";
v0x5759ea1cfba0_0 .net "ready", 0 0, L_0x5759ea218190;  alias, 1 drivers
v0x5759ea217f00_0 .net "rst", 0 0, v0x5759ea2180c0_0;  1 drivers
L_0x5759ea218190 .reduce/nor v0x5759ea2180c0_0;
    .scope S_0x5759ea206fc0;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5759ea2180c0_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x5759ea206fc0;
T_1 ;
    %vpi_call/w 3 5 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 5 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5759ea206fc0 {0 0 0};
    %delay 1, 0;
    %load/vec4 v0x5759ea218020_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 6 "$display", "FAIL cycle=0 signal=ready expected=0 actual=%0d", v0x5759ea218020_0 {0 0 0};
    %vpi_call/w 3 6 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.0 ;
    %vpi_call/w 3 7 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 7 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "/home/mehtama1/git-repo/ai-hardware-analysis/analog-digital-chip-design-eda/benchmarks/seeded_handshake/tb.sv";
    "/home/mehtama1/git-repo/ai-hardware-analysis/analog-digital-chip-design-eda/benchmarks/seeded_handshake/runs/retest/handshake_repaired.sv";
