{
  "schema_version": "register-spec-v1",
  "name": "peripheral",
  "data_width": 32,
  "addr_width": 8,
  "registers": [
    {
      "name": "control",
      "offset": 0,
      "width": 32,
      "reset": 0,
      "fields": [
        {
          "name": "value",
          "lsb": 0,
          "width": 8,
          "access": "RW",
          "reset": 0,
          "description": "Software-controlled peripheral value"
        }
      ]
    },
    {
      "name": "status",
      "offset": 4,
      "width": 32,
      "reset": 1,
      "fields": [
        {
          "name": "ready",
          "lsb": 0,
          "width": 1,
          "access": "RO",
          "reset": 1,
          "description": "Peripheral is ready"
        },
        {
          "name": "error",
          "lsb": 1,
          "width": 1,
          "access": "W1C",
          "reset": 0,
          "description": "Write one to clear the error indication"
        }
      ]
    }
  ]
}
