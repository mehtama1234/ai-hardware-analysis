#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5f20d7b544e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5f20d7b65620 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x5f20d7b80fe0_0 .var "addr", 1 0;
v0x5f20d7b810c0_0 .var "clk", 0 0;
v0x5f20d7b811d0_0 .net "control", 7 0, v0x5f20d7b80430_0;  1 drivers
v0x5f20d7b812c0_0 .net "ready", 0 0, L_0x5f20d7b816d0;  1 drivers
v0x5f20d7b81360_0 .var "rst", 0 0;
v0x5f20d7b814a0_0 .var "valid", 0 0;
v0x5f20d7b81540_0 .var "wdata", 7 0;
v0x5f20d7b81630_0 .var "write", 0 0;
S_0x5f20d7b657b0 .scope module, "dut" "peripheral" 3 4, 4 1 0, S_0x5f20d7b65620;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "valid";
    .port_info 3 /INPUT 1 "write";
    .port_info 4 /INPUT 2 "addr";
    .port_info 5 /INPUT 8 "wdata";
    .port_info 6 /OUTPUT 1 "ready";
    .port_info 7 /OUTPUT 8 "control";
L_0x5f20d7b54db0 .functor AND 1, v0x5f20d7b814a0_0, v0x5f20d7b81630_0, C4<1>, C4<1>;
v0x5f20d7b80860_0 .net "addr", 1 0, v0x5f20d7b80fe0_0;  1 drivers
v0x5f20d7b80940_0 .net "clk", 0 0, v0x5f20d7b810c0_0;  1 drivers
v0x5f20d7b80a10_0 .net "control", 7 0, v0x5f20d7b80430_0;  alias, 1 drivers
v0x5f20d7b80b10_0 .net "ready", 0 0, L_0x5f20d7b816d0;  alias, 1 drivers
v0x5f20d7b80bb0_0 .net "rst", 0 0, v0x5f20d7b81360_0;  1 drivers
v0x5f20d7b80ca0_0 .net "valid", 0 0, v0x5f20d7b814a0_0;  1 drivers
v0x5f20d7b80d40_0 .net "wdata", 7 0, v0x5f20d7b81540_0;  1 drivers
v0x5f20d7b80e10_0 .net "write", 0 0, v0x5f20d7b81630_0;  1 drivers
L_0x5f20d7b816d0 .reduce/nor v0x5f20d7b81360_0;
S_0x5f20d7b681c0 .scope module, "regs" "csr_regs" 4 6, 5 1 0, S_0x5f20d7b657b0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "wr_en";
    .port_info 3 /INPUT 2 "addr";
    .port_info 4 /INPUT 8 "wdata";
    .port_info 5 /OUTPUT 8 "control";
v0x5f20d7b68440_0 .net "addr", 1 0, v0x5f20d7b80fe0_0;  alias, 1 drivers
v0x5f20d7b80370_0 .net "clk", 0 0, v0x5f20d7b810c0_0;  alias, 1 drivers
v0x5f20d7b80430_0 .var "control", 7 0;
v0x5f20d7b804f0_0 .net "rst", 0 0, v0x5f20d7b81360_0;  alias, 1 drivers
v0x5f20d7b805b0_0 .net "wdata", 7 0, v0x5f20d7b81540_0;  alias, 1 drivers
v0x5f20d7b806e0_0 .net "wr_en", 0 0, L_0x5f20d7b54db0;  1 drivers
E_0x5f20d7b2b5d0 .event posedge, v0x5f20d7b80370_0;
    .scope S_0x5f20d7b681c0;
T_0 ;
    %wait E_0x5f20d7b2b5d0;
    %load/vec4 v0x5f20d7b804f0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5f20d7b80430_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5f20d7b806e0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x5f20d7b805b0_0;
    %assign/vec4 v0x5f20d7b80430_0, 0;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5f20d7b65620;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f20d7b810c0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f20d7b81360_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f20d7b814a0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f20d7b81630_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5f20d7b80fe0_0, 0, 2;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5f20d7b81540_0, 0, 8;
    %end;
    .thread T_1, $init;
    .scope S_0x5f20d7b65620;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x5f20d7b810c0_0;
    %inv;
    %store/vec4 v0x5f20d7b810c0_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5f20d7b65620;
T_3 ;
    %vpi_call/w 3 7 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f20d7b65620 {0 0 0};
    %delay 2, 0;
    %load/vec4 v0x5f20d7b812c0_0;
    %cmpi/ne 0, 0, 1;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 8 "$display", "FAIL cycle=0 signal=ready expected=0 actual=%0d", v0x5f20d7b812c0_0 {0 0 0};
    %vpi_call/w 3 8 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_3.0 ;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f20d7b81360_0, 0, 1;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5f20d7b80fe0_0, 0, 2;
    %pushi/vec4 90, 0, 8;
    %store/vec4 v0x5f20d7b81540_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f20d7b814a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f20d7b81630_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5f20d7b811d0_0;
    %cmpi/ne 0, 0, 8;
    %jmp/0xz  T_3.2, 6;
    %vpi_call/w 3 10 "$display", "FAIL cycle=1 signal=control expected=0 actual=%0d", v0x5f20d7b811d0_0 {0 0 0};
    %vpi_call/w 3 10 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_3.2 ;
    %vpi_call/w 3 11 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 11 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_3;
