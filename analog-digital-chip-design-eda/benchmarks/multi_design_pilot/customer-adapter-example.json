{
  "schema_version": "customer-adapter-example-v1",
  "simulator": {
    "tool": "customer-simulator",
    "command_template": ["<simulator>", "<compile-flags>", "<rtl>", "<testbench>"],
    "expected_artifacts": ["compiled-simulation"],
    "status_policy": "recorded-pass-fail-blocked"
  },
  "formal": {
    "tool": "customer-formal-engine",
    "command_template": ["<formal-engine>", "<project>", "<property-set>"],
    "expected_artifacts": ["formal-result.json"],
    "status_policy": "proof-result-separate-from-process-status"
  },
  "coverage": {
    "tool": "customer-coverage-export",
    "command_template": ["<coverage-tool>", "--input", "<regression-db>", "--output", "coverage.json"],
    "expected_artifacts": ["coverage.json"],
    "status_policy": "coverage-is-evidence-not-proof"
  },
  "approval_policy": {
    "design_intent_change": "human approval required",
    "closure_signoff": "human approval required",
    "original_source_mutation": "forbidden"
  }
}
