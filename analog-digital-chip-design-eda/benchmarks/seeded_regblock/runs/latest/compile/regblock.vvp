:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a8d7eeab6c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a8d7eebedd0 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x5a8d7eed4230_0 .var "addr", 1 0;
v0x5a8d7eed4310_0 .var "clk", 0 0;
v0x5a8d7eed43e0_0 .net "reg0", 7 0, v0x5a8d7eed3e00_0;  1 drivers
v0x5a8d7eed44e0_0 .var "rst", 0 0;
v0x5a8d7eed45b0_0 .var "wdata", 7 0;
v0x5a8d7eed46a0_0 .var "wr_en", 0 0;
S_0x5a8d7eebef60 .scope module, "dut" "regblock" 3 3, 4 1 0, S_0x5a8d7eebedd0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /INPUT 1 "wr_en";
    .port_info 3 /INPUT 2 "addr";
    .port_info 4 /INPUT 8 "wdata";
    .port_info 5 /OUTPUT 8 "reg0";
v0x5a8d7eebf110_0 .net "addr", 1 0, v0x5a8d7eed4230_0;  1 drivers
v0x5a8d7eed3d40_0 .net "clk", 0 0, v0x5a8d7eed4310_0;  1 drivers
v0x5a8d7eed3e00_0 .var "reg0", 7 0;
v0x5a8d7eed3ec0_0 .net "rst", 0 0, v0x5a8d7eed44e0_0;  1 drivers
v0x5a8d7eed3f80_0 .net "wdata", 7 0, v0x5a8d7eed45b0_0;  1 drivers
v0x5a8d7eed40b0_0 .net "wr_en", 0 0, v0x5a8d7eed46a0_0;  1 drivers
E_0x5a8d7ee845d0 .event posedge, v0x5a8d7eed3d40_0;
    .scope S_0x5a8d7eebef60;
T_0 ;
    %wait E_0x5a8d7ee845d0;
    %load/vec4 v0x5a8d7eed3ec0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5a8d7eed3e00_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5a8d7eed40b0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x5a8d7eebf110_0;
    %cmpi/e 0, 0, 2;
    %jmp/0xz  T_0.4, 4;
    %load/vec4 v0x5a8d7eed3f80_0;
    %assign/vec4 v0x5a8d7eed3e00_0, 0;
    %jmp T_0.5;
T_0.4 ;
    %load/vec4 v0x5a8d7eed3f80_0;
    %assign/vec4 v0x5a8d7eed3e00_0, 0;
T_0.5 ;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5a8d7eebedd0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a8d7eed4310_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a8d7eed44e0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a8d7eed46a0_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5a8d7eed4230_0, 0, 2;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a8d7eed45b0_0, 0, 8;
    %end;
    .thread T_1, $init;
    .scope S_0x5a8d7eebedd0;
T_2 ;
    %delay 5, 0;
    %load/vec4 v0x5a8d7eed4310_0;
    %inv;
    %store/vec4 v0x5a8d7eed4310_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5a8d7eebedd0;
T_3 ;
    %vpi_call/w 3 6 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 6 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a8d7eebedd0 {0 0 0};
    %delay 12, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a8d7eed44e0_0, 0, 1;
    %pushi/vec4 1, 0, 2;
    %store/vec4 v0x5a8d7eed4230_0, 0, 2;
    %pushi/vec4 170, 0, 8;
    %store/vec4 v0x5a8d7eed45b0_0, 0, 8;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a8d7eed46a0_0, 0, 1;
    %delay 10, 0;
    %load/vec4 v0x5a8d7eed43e0_0;
    %cmpi/ne 0, 0, 8;
    %jmp/0xz  T_3.0, 6;
    %vpi_call/w 3 9 "$display", "FAIL cycle=1 signal=reg0 expected=0 actual=%0d", v0x5a8d7eed43e0_0 {0 0 0};
    %vpi_call/w 3 10 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_3.0 ;
    %vpi_call/w 3 12 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 12 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_3;
