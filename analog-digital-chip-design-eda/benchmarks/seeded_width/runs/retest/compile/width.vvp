#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x64bfd0cff6f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x64bfd0d12710 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x64bfd0d26940_0 .var "data", 7 0;
v0x64bfd0d26a00_0 .net "low", 3 0, L_0x64bfd0d26d20;  1 drivers
v0x64bfd0d26ad0_0 .var "rst", 0 0;
S_0x64bfd0d128a0 .scope module, "dut" "width_adapter" 3 3, 4 1 0, S_0x64bfd0d12710;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "rst";
    .port_info 1 /INPUT 8 "data";
    .port_info 2 /OUTPUT 4 "low";
L_0x74cc9b24f018 .functor BUFT 1, C4<0000>, C4<0>, C4<0>, C4<0>;
v0x64bfd0d019b0_0 .net/2u *"_ivl_0", 3 0, L_0x74cc9b24f018;  1 drivers
v0x64bfd0d26530_0 .net *"_ivl_3", 3 0, L_0x64bfd0d26c00;  1 drivers
v0x64bfd0d26610_0 .net "data", 7 0, v0x64bfd0d26940_0;  1 drivers
v0x64bfd0d266d0_0 .net "low", 3 0, L_0x64bfd0d26d20;  alias, 1 drivers
v0x64bfd0d267b0_0 .net "rst", 0 0, v0x64bfd0d26ad0_0;  1 drivers
L_0x64bfd0d26c00 .part v0x64bfd0d26940_0, 0, 4;
L_0x64bfd0d26d20 .functor MUXZ 4, L_0x64bfd0d26c00, L_0x74cc9b24f018, v0x64bfd0d26ad0_0, C4<>;
    .scope S_0x64bfd0d12710;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x64bfd0d26ad0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x64bfd0d26940_0, 0, 8;
    %end;
    .thread T_0, $init;
    .scope S_0x64bfd0d12710;
T_1 ;
    %vpi_call/w 3 5 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 5 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64bfd0d12710 {0 0 0};
    %delay 1, 0;
    %load/vec4 v0x64bfd0d26a00_0;
    %cmpi/ne 0, 0, 4;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 6 "$display", "FAIL cycle=0 signal=low expected=0 actual=%0d", v0x64bfd0d26a00_0 {0 0 0};
    %vpi_call/w 3 6 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x64bfd0d26ad0_0, 0, 1;
    %pushi/vec4 165, 0, 8;
    %store/vec4 v0x64bfd0d26940_0, 0, 8;
    %delay 1, 0;
    %load/vec4 v0x64bfd0d26a00_0;
    %cmpi/ne 5, 0, 4;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 8 "$display", "FAIL cycle=1 signal=low expected=5 actual=%0d", v0x64bfd0d26a00_0 {0 0 0};
    %vpi_call/w 3 8 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.2 ;
    %vpi_call/w 3 9 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 9 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_1;
