{
  "schema_version": "mutation-suite-v1",
  "name": "first-mutation-closure-seeded-task",
  "mutations": [
    {
      "mutation_id": "counter-ignore-enable",
      "description": "Remove the enable guard from a known-good counter.",
      "source_file": "benchmarks/seeded_counter/counter.sv",
      "from": "      if (enable) counter_q <= counter_q + 4'd1; // SEEDED_BUG: missing enable guard",
      "to": "      counter_q <= counter_q + 4'd1; // SEEDED_MUTATION: ignored enable",
      "command": ["python3", "scripts/run_seeded_counter_check.py", "benchmarks/seeded_counter/counter.sv", "benchmarks/seeded_counter/tb.sv"]
    }
  ]
}
