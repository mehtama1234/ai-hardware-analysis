#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5cb1792ce1d0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5cb1792e0db0 .scope module, "tb" "tb" 3 1;
 .timescale 0 0;
v0x5cb1792f5aa0_0 .net "grant", 1 0, L_0x5cb1792f5d30;  1 drivers
v0x5cb1792f5b60_0 .var "req", 1 0;
v0x5cb1792f5c00_0 .var "rst", 0 0;
S_0x5cb1792e0f40 .scope module, "dut" "arbiter" 3 3, 4 1 0, S_0x5cb1792e0db0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "rst";
    .port_info 1 /INPUT 2 "req";
    .port_info 2 /OUTPUT 2 "grant";
L_0x7bdb43c2f018 .functor BUFT 1, C4<00>, C4<0>, C4<0>, C4<0>;
v0x5cb1792d06b0_0 .net/2u *"_ivl_0", 1 0, L_0x7bdb43c2f018;  1 drivers
v0x5cb1792f55f0_0 .net "grant", 1 0, L_0x5cb1792f5d30;  alias, 1 drivers
v0x5cb1792f56d0_0 .net "grant_a", 0 0, L_0x5cb1792f5f10;  1 drivers
v0x5cb1792f5770_0 .net "grant_b", 0 0, L_0x5cb1792f5fb0;  1 drivers
v0x5cb1792f5830_0 .net "req", 1 0, v0x5cb1792f5b60_0;  1 drivers
v0x5cb1792f5960_0 .net "rst", 0 0, v0x5cb1792f5c00_0;  1 drivers
L_0x5cb1792f5d30 .functor MUXZ 2, v0x5cb1792f5b60_0, L_0x7bdb43c2f018, v0x5cb1792f5c00_0, C4<>;
L_0x5cb1792f5f10 .part L_0x5cb1792f5d30, 0, 1;
L_0x5cb1792f5fb0 .part L_0x5cb1792f5d30, 1, 1;
    .scope S_0x5cb1792e0db0;
T_0 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5cb1792f5c00_0, 0, 1;
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5cb1792f5b60_0, 0, 2;
    %end;
    .thread T_0, $init;
    .scope S_0x5cb1792e0db0;
T_1 ;
    %vpi_call/w 3 5 "$dumpfile", "waveform.vcd" {0 0 0};
    %vpi_call/w 3 5 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5cb1792e0db0 {0 0 0};
    %delay 1, 0;
    %load/vec4 v0x5cb1792f5aa0_0;
    %cmpi/ne 0, 0, 2;
    %jmp/0xz  T_1.0, 6;
    %vpi_call/w 3 6 "$display", "FAIL cycle=0 signal=grant expected=0 actual=%0d", v0x5cb1792f5aa0_0 {0 0 0};
    %vpi_call/w 3 6 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5cb1792f5c00_0, 0, 1;
    %pushi/vec4 2, 0, 2;
    %store/vec4 v0x5cb1792f5b60_0, 0, 2;
    %delay 1, 0;
    %load/vec4 v0x5cb1792f5aa0_0;
    %cmpi/ne 2, 0, 2;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 8 "$display", "FAIL cycle=1 signal=grant expected=2 actual=%0d", v0x5cb1792f5aa0_0 {0 0 0};
    %vpi_call/w 3 8 "$finish", 32'sb00000000000000000000000000000001 {0 0 0};
T_1.2 ;
    %vpi_call/w 3 9 "$display", "PASS" {0 0 0};
    %vpi_call/w 3 9 "$finish", 32'sb00000000000000000000000000000000 {0 0 0};
    %end;
    .thread T_1;
