-between gap-3 border-b border-current/10 px-3 py-1.5"><span class="font-mono text-xs text-current/60">python</span><button data-slot="xds-button" aria-label="Copy code" type="button" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-semibold select-none transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-6 min-w-6 text-subtext1 [&amp;_svg:not([class*='size-'])]:size-3 text-primary hover:bg-btn-ghost-hover active:bg-btn-ghost-pressed px-3" style="border-radius: 9999px;"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-3 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity: 1;"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-copy-stroke" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path fill-rule="evenodd" d="M11.2002 7C12.0237 7 12.7016 6.99898 13.252 7.04395C13.814 7.08988 14.3311 7.18827 14.8164 7.43555C15.5689 7.81902 16.181 8.43109 16.5645 9.1836C16.8117 9.6689 16.9101 10.186 16.9561 10.748C17.001 11.2984 17 11.9763 17 12.7998V16.2002C17 17.0237 17.001 17.7016 16.9561 18.252C16.9101 18.814 16.8117 19.3311 16.5645 19.8164C16.181 20.5689 15.5689 21.181 14.8164 21.5645C14.3311 21.8117 13.814 21.9101 13.252 21.9561C12.7016 22.001 12.0237 22 11.2002 22H7.79981C6.97632 22 6.29843 22.001 5.74805 21.9561C5.18599 21.9101 4.6689 21.8117 4.1836 21.5645C3.43109 21.181 2.81902 20.5689 2.4